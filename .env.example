# Database (compose overrides this to the internal hostname `db`)
DATABASE_URL=postgresql://finance:finance@db:5432/finance

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
INITIAL_ADMIN_EMAIL=admin@finance.local
INITIAL_ADMIN_PASSWORD=ChangeMeNow!123

# App — LAN access on smaug (http://192.168.1.30:3100)
AI_ENABLED=false
CORS_ORIGIN=http://192.168.1.30:3100,http://localhost:3000,http://localhost:3100
HOUSEHOLD_TIMEZONE=Asia/Kolkata
NODE_ENV=production
API_PORT=4000
# false for plain HTTP on the LAN; set true only if you terminate TLS in front
COOKIE_SECURE=false
APP_LOCK_PIN=

# Web (browser calls same-origin /v1 via Next rewrites → api container)
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_URL=http://api:4000
