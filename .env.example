# Database (internal Docker network hostname in compose)
DATABASE_URL=postgresql://finance:finance@db:5432/finance

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
INITIAL_ADMIN_EMAIL=admin@finance.local
INITIAL_ADMIN_PASSWORD=ChangeMeNow!123

# App
AI_ENABLED=false
CORS_ORIGIN=https://finance.local,http://localhost:3000
HOUSEHOLD_TIMEZONE=Asia/Kolkata
NODE_ENV=development
API_PORT=4000
COOKIE_SECURE=false
APP_LOCK_PIN=

# Web (browser → same-origin /v1 via Caddy in production)
NEXT_PUBLIC_API_BASE_URL=
